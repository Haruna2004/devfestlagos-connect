{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devfestlagos-connect",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Forking? Change the route + database_id + bucket_name to your own (see README).
  "routes": [{ "pattern": "devfestlagos-connect.harunafaruk.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/photos/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devfestlagos-connect",
      "database_id": "c1512785-6e51-43ab-9f63-a135ab89031b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "devfestlagos-connect-photos" }],
  "vars": {
    // Landmark Event Centre, Oniru, Lagos. Set VENUE_RADIUS_M to "0" to allow anywhere.
    "VENUE_LAT": "6.42312",
    "VENUE_LNG": "3.44535",
    "VENUE_RADIUS_M": "250"
  },
  "observability": { "enabled": true }
}
